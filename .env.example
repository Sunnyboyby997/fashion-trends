# ============================================================
# 复制本文件为 .env，然后填入你自己的密钥。
# 所有密钥均为可选：不填也能运行（自动进入演示模式）。
# ============================================================

# ---- Unsplash 图库 Access Key ----
# 申请步骤（免费）：https://unsplash.com/developers
#   1. 注册/登录开发者账号；
#   2. "Your apps" → "New application"，同意 API 条款；
#   3. 在应用详情页复制 "Access Key" 填到这里。
# 免费额度约 50 次请求/小时。
UNSPLASH_ACCESS_KEY=

# （可选）Unsplash 官方 demo 应用密钥，速率受限，仅演示用。
UNSPLASH_DEMO_KEY=

# ---- 大模型（Anthropic / Claude）----
# 申请步骤：https://console.anthropic.com 创建 API Key。
ANTHROPIC_API_KEY=
# 默认使用 claude-opus-5，可按需替换。
ANTHROPIC_MODEL=claude-opus-5

# ---- 定时任务 ----
# daily(每日) / weekly(每周) / off(关闭定时，仅手动刷新)
SCHEDULE_MODE=daily
# 触发时间（24 小时制，默认凌晨 3 点错峰）
SCHEDULE_TIME=03:00
# weekly 模式下生效：mon ~ sun
SCHEDULE_WEEKDAY=mon
# 排程时区（默认中国时区 UTC+8）
SCHEDULE_TZ=Asia/Shanghai

# ---- 真实趋势数据源（Google Trends / pytrends）----
# Google 在中国大陆无法直连，如需实时数据请配置本地代理：
# 例如 TRENDS_PROXY=http://127.0.0.1:7890 （Clash/V2Ray 本地端口）
# 不配置代理时，若无法访问 Google，会自动降级为「离线样例」并明确标注。
TRENDS_PROXY=
# 时间窗口：today 3-m = 近 90 天；today 12-m = 近 12 个月
TRENDS_TIMEFRAME=today 3-m
# 地域：留空=全球；可填 US / GB / CN 等
TRENDS_GEO=

# ---- 服务端口 ----
PORT=8000
